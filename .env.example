# Proyecto Supabase (Settings > API). Ambos valores son públicos:
# la seguridad la dan las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (para enlaces para compartir, sitemap y metadatos)
NEXT_PUBLIC_SITE_URL=https://jcfragances2026.vercel.app

# Avisos por correo cuando cambia la etapa de un pedido (opcional, https://resend.com).
# Sin estas dos variables la tienda funciona igual y simplemente no envía correos.
# RESEND_API_KEY es SECRETA: configúrala solo en Vercel (tipo Sensitive), nunca en el repositorio.
RESEND_API_KEY=
EMAIL_FROM="JS FRAGANCES <pedidos@tu-dominio.com>"
